config_version=5

[application]

config/name="Shtick"
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.043, 0.047, 0.055, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/brand/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Profile="*res://scripts/profile.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=540
window/size/window_width_override=1170
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=3
